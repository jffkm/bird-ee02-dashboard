# The installer copies this file to /etc/bird-inky.env on first install.
# Edit the installed file, not this committed template.

# GitHub Pages URL for the native-resolution PNG.
BIRD_IMAGE_URL=https://YOUR_USERNAME.github.io/bird-inky-dashboard/today.png

# Optional: leave blank unless you want the Pi to fetch metadata for logging.
BIRD_META_URL=https://YOUR_USERNAME.github.io/bird-inky-dashboard/today.json

# Where the Pi should keep the last successfully downloaded PNG across reboots.
BIRD_CACHE_DIR=/var/lib/bird-inky

# Stay online for the first hardware test. Change to 1 after it works so the Pi
# powers off after every successful or failed update.
BIRD_POWER_OFF=0

# Seconds to wait for Wi-Fi/HTTP before using the cached image.
BIRD_DOWNLOAD_TIMEOUT=30

# Retry a boot-time download while Wi-Fi is still coming online.
BIRD_DOWNLOAD_ATTEMPTS=4
BIRD_RETRY_DELAY=10
